# Sovereign IRC bridge — example only. Never commit real certs or keys.
# Nested env uses SovereignConfig env_nested_delimiter="__"

# IRC (irc.abjects.net)
IRC__HOST=irc.abjects.net
IRC__PORT=6697
IRC__MTLS_CERT_PATH=/etc/mtls/client.crt
IRC__MTLS_KEY_PATH=/etc/mtls/client.key
IRC__MTLS_CA_PATH=/etc/mtls/ca.crt

# Bridge
BRIDGE_WS_BIND_HOST=0.0.0.0
BRIDGE_WS_BIND_PORT=8080
BRIDGE_MAX_BUFFER_SIZE=65536

# Deploy
DEPLOY_ENVIRONMENT=development
DEPLOY_LOG_LEVEL=INFO
DEPLOY_AUTONOMOUS_MODE=true
