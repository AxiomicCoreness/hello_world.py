# ==================================================================
# ClarkeYoursaTee — Java 17 / Maven on GitCode
# ==================================================================
# The repo is Java/Maven. Python patterns are kept because the
# CodeArts Doer agent and any local tooling may drop Python
# side-effects into the checkout. .codeartsdoer/ is GitCode-specific.
# ==================================================================

# --- Java / Maven -------------------------------------------------
*.class
*.jar
*.war
*.ear
target/
build/
out/
.gradle/
dependency-reduced-pom.xml

# --- Python side-effects (CodeArts Doer + local tooling) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
dist/
/lib/
/lib64/
/var/

# --- Virtual environments -----------------------------------------
.env
*.env
.venv/
venv/
env/
ENV/

# --- Testing ------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Local builds / Merge state -----------------------------------
.merge/
.merge/merged_manifest.yaml
.merge/merged_report.json
.merge/expected_sha3_256.json
.merge/merkle_root.json
.merge/merkle_root_*.json

# --- IOC download cache -------------------------------------------
# iphone12_ioc_terminal.py — keep tree, not contents
artifacts/iocs/**
!artifacts/iocs/.gitkeep

# --- IDE ----------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/private/
nbproject/Makefile-*.mk
nbproject/configurations.xml
*.swp
*.swo
*~

# --- GitCode platform --------------------------------------------
.codeartsdoer/

# --- OS -----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Logs / temp --------------------------------------------------
*.log
*.log.*
logs/
*.tmp
*.bak
.worker-hooks/

# --- Build side-effects -------------------------------------------
*.exec
hs_err_pid*
replay_pid*

# --- Local state --------------------------------------------------
sovereign_state.json
soul_array_declaration.json
verification_report.json

# Generated by beacons/sovereign_engine_deepseek.py write_sovereign_state()
beacons/sovereign_state.py

# scripts/t_rotator_graphs.py default output (generated, not ledger)
t_rotator_out/
