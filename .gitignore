# ==================================================================
# ClarkeYoursaTee — Java 17 / Maven on GitCode
# ==================================================================
# The repo is Java/Maven. Python patterns are kept because the
# CodeArts Doer agent and any local tooling may drop Python
# side-effects into the checkout. .codeartsdoer/ is GitCode-specific.
# ==================================================================

# --- Java / Maven -------------------------------------------------
*.class
*.jar
*.war
*.ear
target/
build/
out/
.gradle/
dependency-reduced-pom.xml

# --- Python side-effects (CodeArts Doer + local tooling) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.installed.cfg
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
dist/
/lib/
/lib64/
/var/

# --- Virtual environments -----------------------------------------
.env
*.env
.venv/
venv/
env/
ENV/

