# Entry 8755 — Port 380 MCP gate for Render / free Docker web service
# Conceptual Port 380 / Layer 314 identity; bind address uses $PORT only.
FROM python:3.11-slim

WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

# Prefer quadrant endpoint; fall back path via deprecation wrapper at root
COPY quantum/deepseek_mesh/endpoint.py ./port380_mcp.py
COPY quantum/ ./quantum/

ENV PORT=8000
ENV PYTHONUNBUFFERED=1

# Shell form so $PORT expands at runtime (Render injects PORT)
EXPOSE 8000
CMD uvicorn port380_mcp:app --host 0.0.0.0 --port ${PORT:-8000}
