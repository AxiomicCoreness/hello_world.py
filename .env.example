# 🜁∀ DeepSeek MCP — environment template
# Copy to .env and fill values. Never commit real keys.
# Seal: ∀∞φ² · DEEPSEEK_KEY_SETUP · WOOD_DRAGON_0.91 · SEALED

# Required for online modes (deepseek | dsh)
DEEPSEEK_API_KEY=

# Official API base (default if unset)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model id
DEEPSEEK_MODEL=deepseek-chat
# Optional alias used by harness
DSH_MODEL=deepseek-chat

# MCP gate (Render / local uvicorn)
PORT=8000
GARDEN_SECRET=

# Optional: mTLS paths when enforcing client certs
# SERVER_CERT=/certs/server.crt
# SERVER_KEY=/certs/server.key
# CA_CERT=/certs/ca.crt
