{
  "note": "Values are never stored in git. *** means set in GitHub Actions secrets or the runner env.",
  "do_not_use": ["GARDEN_SECRETS", "SUPERSECRET", "github_token"],
  "github_token": {
    "actions_context": "${{ secrets.GITHUB_TOKEN }}",
    "env_name": "GH_TOKEN",
    "source": "automatic per-workflow token, not a repo secret named github_token",
    "value": "***"
  },
  "NPM_TOKEN": {
    "actions_context": null,
    "status": "unused — this repo is Python, not npm",
    "value": "***"
  },
  "SUPERSECRET": {
    "replace_with": "GARDEN_SECRET",
    "actions_context": "${{ secrets.GARDEN_SECRET }}",
    "header": "X-Garden-Secret",
    "value": "***"
  },
  "required_repo_secrets": {
    "GARDEN_SECRET": "${{ secrets.GARDEN_SECRET }}",
    "MCP_URL": "${{ secrets.MCP_URL }}"
  },
  "optional_repo_secrets": {
    "DEEPSEEK_API_KEY": "${{ secrets.DEEPSEEK_API_KEY }}",
    "DEEPSEEK_BASE_URL": "${{ secrets.DEEPSEEK_BASE_URL }}",
    "DEEPSEEK_MODEL": "${{ secrets.DEEPSEEK_MODEL }}"
  },
  "non_secret_env": {
    "MCP_CONNECTOR_URL": "http://127.0.0.1:380"
  }
}
