# Container surface for port380_mcp (stdlib-heavy path)
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/ ./app/
COPY quantum/ ./quantum/
ENV PORT=8024
EXPOSE 8024
# Restart semantics: rely on orchestrator (k8s restartPolicy, systemd, etc.)
CMD ["python", "-m", "app.main"]
