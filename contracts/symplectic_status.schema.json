{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["role", "event", "timestamp", "coherence", "phi_phase"],
  "properties": {
    "role": {"type": "string", "enum": ["system", "lattice", "pod", "frb_bridge", "orchestrator", "worker", "validator"]},
    "event": {"type": "string"},
    "timestamp": {"type": "string"},
    "coherence": {"type": "number", "minimum": 0, "maximum": 1},
    "phi_phase": {"type": "number"},
    "entropy": {"type": "number", "minimum": 0},
    "predicted_score": {"type": "number"},
    "prediction_error": {"type": "number"},
    "command": {"type": "string", "enum": ["wait", "nudge_cronjob", "record_only"]}
  },
  "additionalProperties": false
}
