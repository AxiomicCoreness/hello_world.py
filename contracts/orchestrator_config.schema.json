{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["worker_url", "oidc_issuer", "oidc_client_id", "thresholds"],
  "properties": {
    "worker_url": {"type": "string"},
    "oidc_issuer": {"type": "string"},
    "oidc_client_id": {"type": "string"},
    "oidc_client_secret_present": {"type": "boolean"},
    "thresholds": {
      "type": "object",
      "required": ["coherence_fire", "coherence_nudge", "error_tolerance"],
      "properties": {
        "coherence_fire": {"type": "number", "minimum": 0, "maximum": 1},
        "coherence_nudge": {"type": "number", "minimum": 0, "maximum": 1},
        "error_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
