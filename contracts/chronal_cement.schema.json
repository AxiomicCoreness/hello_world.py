{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["timestamp", "phi_phase", "coherence", "seal"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of the cement payload"
    },
    "phi_phase": {
      "type": "number",
      "description": "Phase in seconds at sealing"
    },
    "coherence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "System coherence at sealing time"
    },
    "seal": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "HMAC-SHA256(timestamp + phi_phase + coherence + secret)"
    }
  },
  "additionalProperties": false
}