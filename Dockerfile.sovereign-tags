FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements.sovereign-tags.txt .
RUN pip install --no-cache-dir -r requirements.sovereign-tags.txt

COPY core/sovereign_tags.py ./sovereign_tags.py

USER 1000:1000
EXPOSE 8090
CMD ["uvicorn", "sovereign_tags:app", "--host", "0.0.0.0", "--port", "8090"]
